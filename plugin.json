{
  "Id": "73ea42c5-d034-4e69-a4a6-0b78ddd6b9a7",
  "TriggerKeywords": ["todo"],
  "Name": "Todo",
  "Description": "本地待办事项管理插件",
  "Author": "Flartiny",
  "Version": "1.0.1",
  "MinWoxVersion": "2.0.4",
  "Runtime": "NODEJS",
  "Website": "https://github.com/Flartiny/Wox.Plugin.Todo",
  "Entry": "index.js",
  "Icon": "relative:images/logo.png",
  "SupportedOS": ["Windows", "Linux", "Darwin"],
  "SettingDefinitions": [
    {
      "Type": "textbox",
      "Value": {
        "Key": "expireDays",
        "Label": "已完成任务过期天数",
        "DefaultValue": "30",
        "Tooltip": "已完成任务保留的天数，到期自动清理；输入 0 表示永不清除，上限 365 天",
        "Suffix": "天",
        "MaxLines": 1,
        "Validators": [
          {
            "Type": "is_number",
            "Value": {
              "IsInteger": true,
              "IsFloat": false
            }
          }
        ]
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "preventHideAfterAction",
        "Label": "操作后保持窗口显示",
        "DefaultValue": "true",
        "Tooltip": "启用后，添加/标记完成/删除/修改后 Wox 窗口保持显示，便于连续操作列表（此时按上方向键可正常在列表内循环导航）；关闭则操作后自动隐藏窗口"
      },
      "DisabledInPlatforms": [],
      "IsPlatformSpecific": false
    }
  ]
}
